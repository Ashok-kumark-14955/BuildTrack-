.env
.env.local
.env.*.local
*.env
.mcp.json

# ── SQLite database files ─────────────────────
*.db
*.db-shm
*.db-wal

# ── Uploaded files (binary assets) ───────────
backend/uploads/

# ── OS / Editor ───────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── TypeScript cache ──────────────────────────
*.tsbuildinfo

# ── Logs ─────────────────────────────────────
logs/
*.log

# ── Test coverage ─────────────────────────────
coverage/

# ── Nested repo (not part of this project) ────
# Local fork of catalystbyzoho/agent-skills for AI-agent tooling; was tracked
# as a submodule gitlink with no .gitmodules entry, which broke CI checkout
# ("No url found for submodule path 'agent-skills'") on every push.
agent-skills/
